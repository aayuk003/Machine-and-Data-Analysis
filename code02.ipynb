"""
Program 3: Analyze and Summarize Datasets from Manufacturing / Energy / Healthcare domains
"""
 
import pandas as pd
import numpy as np
 
np.random.seed(42)
 
 
def generate_domain_data(domain, n=20):
    if domain == "manufacturing":
        return pd.DataFrame({
            "machine_id": range(1, n + 1),
            "output_units": np.random.randint(80, 150, n),
            "defect_rate": np.round(np.random.uniform(0.5, 5.0, n), 2),
            "downtime_hours": np.round(np.random.uniform(0, 4, n), 1)
        })
    elif domain == "energy":
        return pd.DataFrame({
            "plant_id": range(1, n + 1),
            "power_output_mw": np.round(np.random.uniform(100, 500, n), 1),
            "fuel_consumption": np.round(np.random.uniform(50, 200, n), 1),
            "efficiency_pct": np.round(np.random.uniform(30, 60, n), 1)
        })
    elif domain == "healthcare":
        return pd.DataFrame({
            "patient_id": range(1, n + 1),
            "age": np.random.randint(18, 90, n),
            "blood_pressure": np.random.randint(90, 180, n),
            "recovery_days": np.random.randint(1, 20, n)
        })
    else:
        raise ValueError("Unknown domain")
 
 
def summarize(df, domain):
    print(f"\n===== {domain.upper()} DATASET SUMMARY =====")
    print(f"Number of records: {len(df)}")
    print("\nFirst 5 rows:")
    print(df.head())
    print("\nDescriptive statistics:")
    print(df.describe().round(2))
    print("\nColumn-wise missing values:")
    print(df.isnull().sum())
 
 
if __name__ == "__main__":
    for domain in ["manufacturing", "energy", "healthcare"]:
        dataset = generate_domain_data(domain)
        summarize(dataset, domain)
